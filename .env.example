# Copie ce fichier en .env.local et remplis-le (Supabase > Project Settings > API Keys).
# Sans ces valeurs, l'app utilise ses contenus intégrés (src/data/).
# Ne mets jamais ici la clé secrète ni le mot de passe de la base.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
